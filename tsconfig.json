{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "vite/client", "web-bluetooth"]
  },
  "include": [".vitepress/**/*.ts", "test"],
  "exclude": ["node_modules", "dist", ".vitepress/cache"]
}
